# Server settings for deploy/docker-compose.yml. Copy and fill in:
#     cp .env.example .env
# .env is git-ignored: it holds passwords. Never commit it.

# ---- Required ---------------------------------------------------------------
# Database password (any long random string; only the containers use it).
POSTGRES_PASSWORD=
# Signs sign-in cookies. 64 random hex characters:  openssl rand -hex 32
AUTH_SECRET=

# ---- Email (forgot-password codes) -----------------------------------------
# Gmail: SMTP_PASSWORD is an App password (Google Account > Security >
# 2-Step Verification > App passwords), not your Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="TRAFFIX <you@example.com>"
AUTH_DEV_LOG_CODES=false

# ---- Sign-in ------------------------------------------------------------------
# true behind https (the tunnel, Caddy). false only for plain http testing.
AUTH_COOKIE_SECURE=true
AUTH_SESSION_HOURS=12
API_REQUIRE_SIGN_IN=true

# ---- Simulation and crews -------------------------------------------------------
SIM_DEMAND=light
SIM_REALTIME_FACTOR=1.0
# ITMS_SCENARIO=scenarios/generated/amaravati_capital   # and VITE_CITY=amaravati
CREW_AUTO_ACCEPT=true
CREW_REQUIRE_SIGN_IN=false

# ---- Web app (applied when the image is built) --------------------------------
# Cities the console shows ("" = both) and the one the simulation runs.
VITE_CITY=
VITE_LIVE_CITY=

# ---- Where it listens ---------------------------------------------------------------
# http://127.0.0.1:8080 on this machine. 0.0.0.0 opens it to your network.
HTTP_PORT=8080
HTTP_BIND=127.0.0.1
# With `--profile https` on a server: your domain, e.g. traffix.duckdns.org
SITE_DOMAIN=
