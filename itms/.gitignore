data/

# Runtime state: uploaded road videos with their analysis results and
# snapshots (CLIPS_DIR, api-service + vision-service), and evidence clips.
var/

# Redis persistence snapshot -- a runtime artifact from `make dev`'s redis
# container, not source. Regenerates on the next `docker compose up`.
dump.rdb

# Regenerable raw OSM downloads (large; scenarios/networks/*/build.sh recreates
# them). The filtered/converted outputs ARE committed -- see each network's README.
scenarios/networks/*/raw_osm.xml

# M6 detector artifacts -- large regenerable binaries: the recorded feature
# arrays (*.npy, ~6 MB each), trained weights (model.pt), and training logs.
# Recreate with scripts/m6_record_features.py + scripts/m6_train_detector.py.
# The gate's JSON output under scripts/results/ IS committed, per that dir's
# convention.
scripts/results/m6_artifacts/

# Office lock/temp files
~$*
