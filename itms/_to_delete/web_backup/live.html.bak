<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>ITMS — Live console</title>
<meta name="theme-color" content="#101416" />
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='16' fill='%2314181A'/%3E%3Crect x='14.8' y='7' width='2.4' height='9' rx='1.2' fill='%233FE0FF'/%3E%3Crect x='7' y='14.8' width='9' height='2.4' rx='1.2' fill='%235C6B70'/%3E%3C/svg%3E" />
<link rel="stylesheet" href="vendor/leaflet/leaflet.css" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  --dark:#101416; --cy:#3FE0FF;
  --sans:'Plus Jakarta Sans',-apple-system,sans-serif;
  --mono:'IBM Plex Mono',ui-monospace,monospace;
  --gut:clamp(16px,3vw,32px);
}
*{box-sizing:border-box;margin:0;padding:0;}
html,body{height:100%;}
body{background:var(--dark);color:#fff;font-family:var(--sans);letter-spacing:-.011em;
  -webkit-font-smoothing:antialiased;display:flex;flex-direction:column;}
a{color:inherit;text-decoration:none;}
:focus-visible{outline:2px solid #fff;outline-offset:3px;border-radius:4px;}

.topbar{display:flex;align-items:center;justify-content:space-between;gap:12px;
  padding:16px var(--gut);border-bottom:1px solid #1F262A;flex:0 0 auto;}
.topbar .mark{display:flex;align-items:center;gap:9px;font-weight:700;font-size:15px;color:#fff;}
.topbar .glyph{width:26px;height:26px;border-radius:50%;background:#fff;position:relative;flex:0 0 26px;}
.topbar .glyph::before{content:'';position:absolute;left:50%;top:6px;width:2.4px;height:9px;border-radius:2px;
  background:var(--dark);transform:translateX(-50%);}
.topbar .glyph::after{content:'';position:absolute;left:50%;bottom:6px;width:9px;height:2.4px;border-radius:2px;
  background:var(--dark);transform:translateX(-50%);}
.topbar .back{font-size:13.5px;color:#8FA5AD;padding:8px 14px;border-radius:999px;border:1px solid #232A2D;
  transition:color .2s,border-color .2s;}
.topbar .back:hover{color:#fff;border-color:#3a4448;}

main{flex:1 1 auto;padding:var(--gut);min-height:0;display:flex;}
.wrap{max-width:1280px;margin:0 auto;width:100%;display:flex;flex-direction:column;min-height:0;}

/* ---------- live console (from console.html) ---------- */
.consolecard{background:#12171A;border-radius:22px;padding:clamp(16px,2.4vw,26px);position:relative;
  overflow:hidden;flex:1;display:flex;flex-direction:column;min-height:0;border:1px solid #1F262A;}
.conhead{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;
  position:relative;margin-bottom:14px;}
.conhead h3{color:#fff;font-size:18px;font-weight:600;letter-spacing:-.02em;}
.constatus{display:inline-flex;align-items:center;gap:7px;font-family:var(--mono);font-size:11.5px;
  padding:5px 12px;border-radius:999px;background:#1B2225;color:#8FA5AD;}
.constatus .dot{width:7px;height:7px;border-radius:50%;background:#5E7178;}
.constatus.open{color:#7BE3C7;background:#153A31;}
.constatus.open .dot{background:#57C97B;}
.constatus.closed{color:#E8A3A3;background:#3A1212;}
.constatus.closed .dot{background:#C8384A;}
.congrid{display:grid;grid-template-columns:2fr 1fr;gap:14px;position:relative;flex:1;min-height:0;}
#conmap{height:100%;min-height:340px;border-radius:14px;border:1px solid #232A2D;background:#0F151C;}
.conside{display:flex;flex-direction:column;gap:12px;min-height:0;}
.constats{display:flex;gap:10px;}
.constat{flex:1;background:#161D20;border:1px solid #232A2D;border-radius:12px;padding:12px 14px;}
.constat b{display:block;font-size:22px;color:#fff;font-weight:700;letter-spacing:-.03em;
  font-variant-numeric:tabular-nums;}
.constat span{display:block;font-size:10.5px;color:#5E7178;font-family:var(--mono);letter-spacing:.05em;
  text-transform:uppercase;margin-top:4px;}
.conlogwrap{flex:1;min-height:0;background:#161D20;border:1px solid #232A2D;border-radius:12px;
  padding:10px 12px;overflow-y:auto;font-family:var(--mono);font-size:10.5px;color:#8FA5AD;}
.conlogwrap .row{white-space:pre-wrap;word-break:break-all;border-bottom:1px solid #1B2225;padding:5px 0;}
.conlogwrap .row:last-child{border-bottom:0;}
.conlogwrap .row .ts{color:#4E6068;}
.conlogwrap .row b{color:#DCE7EA;}
.connote{font-size:12px;color:#7E9098;margin-top:14px;position:relative;line-height:1.6;}

@media(max-width:860px){
  .congrid{grid-template-columns:1fr;}
  #conmap{height:340px;}
}
</style>
</head>
<body>

<div class="topbar">
  <a class="mark" href="index.html"><span class="glyph"></span>ITMS</a>
  <a class="back" href="index.html">← Back to overview</a>
</div>

<main>
  <div class="wrap">
    <div class="consolecard">
      <div class="conhead">
        <h3>Vijayawada corridor — MG Road, Benz Circle → PNBS</h3>
        <span class="constatus connecting" id="constatus"><i class="dot"></i><span id="constatusText">connecting…</span></span>
      </div>
      <div class="congrid">
        <div id="conmap"></div>
        <div class="conside">
          <div class="constats">
            <div class="constat"><b id="conVeh">0</b><span>vehicles on map</span></div>
            <div class="constat"><b id="conEvt">0</b><span>events received</span></div>
          </div>
          <div class="conlogwrap" id="conlog"></div>
        </div>
      </div>
      <p class="connote">If the map looks idle, the simulation isn't running right now — it stays idle rather
        than fake a connection.</p>
    </div>
  </div>
</main>

<script src="vendor/leaflet/leaflet.js"></script>
<script src="network_data.js"></script>
<script>
(function(){
"use strict";

var WS_URL = (window.ITMS_WS_URL) || "ws://localhost:8000/v1/stream";
var statusWrap = document.getElementById("constatus");
var statusText = document.getElementById("constatusText");
var logEl = document.getElementById("conlog");
var vehCountEl = document.getElementById("conVeh");
var evtCountEl = document.getElementById("conEvt");
var evtCount = 0;
var STALE_MS = 5000;

function setStatus(state, label){
  statusWrap.className = "constatus " + state;
  statusText.textContent = label;
}

function appendRow(envelope){
  var div = document.createElement("div");
  div.className = "row";
  var payload = JSON.stringify(envelope.payload);
  div.innerHTML = '<span class="ts">' + envelope.occurred_at + '</span> ' +
    '<b>' + envelope.event_type + '</b> ' + payload;
  logEl.prepend(div);
  while (logEl.childElementCount > 300) logEl.removeChild(logEl.lastChild);
}

var mapEl = document.getElementById("conmap");
if (!mapEl || typeof L === "undefined") return;

var network = window.ITMS_NETWORK || { type: "FeatureCollection", features: [] };
var edgeFeatures = network.features.filter(function(f){ return f.properties.kind === "edge"; });
var junctionFeatures = network.features.filter(function(f){ return f.properties.kind === "junction"; });

var map = L.map(mapEl, { zoomControl: true });
L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
  attribution: '&copy; OpenStreetMap contributors', maxZoom: 19,
}).addTo(map);

var roadLayer = L.geoJSON(edgeFeatures, {
  style: function(){ return { color: "#3d5568", weight: 3, opacity: 0.9 }; },
}).addTo(map);

var edgeLayers = {};
roadLayer.eachLayer(function(layer){ edgeLayers[layer.feature.properties.edge_id] = layer; });

L.geoJSON(junctionFeatures, {
  filter: function(f){ return f.properties.is_traffic_light; },
  pointToLayer: function(f, latlng){
    return L.circleMarker(latlng, { radius: 5, color: "#ffb020", weight: 1, fillColor: "#ffb020", fillOpacity: 0.85 })
      .bindTooltip(f.properties.junction_id);
  },
}).addTo(map);

if (edgeFeatures.length) { map.fitBounds(roadLayer.getBounds(), { padding: [16, 16] }); }
else { map.setView([16.506, 80.633], 15); }

setTimeout(function(){ map.invalidateSize(); }, 0);
window.addEventListener("resize", function(){ map.invalidateSize(); });

function occupancyColor(occupancy){
  var t = Math.max(0, Math.min(1, occupancy));
  var rr = Math.round(61 + t * (220 - 61));
  var gg = Math.round(85 + t * (60 - 85));
  var bb = Math.round(104 + t * (60 - 104));
  return "rgb(" + rr + "," + gg + "," + bb + ")";
}

var vehicles = new Map();
function upsertVehicle(payload){
  var id = payload.vehicle_id;
  var latlng = [payload.lat, payload.lon];
  var entry = vehicles.get(id);
  if (!entry) {
    var marker = L.circleMarker(latlng, { radius: 4, color: "#7fd1ff", weight: 1, fillColor: "#7fd1ff", fillOpacity: 0.9 })
      .bindTooltip(id, { direction: "top" });
    marker.addTo(map);
    vehicles.set(id, { marker: marker, lastSeen: Date.now() });
  } else {
    entry.marker.setLatLng(latlng);
    entry.lastSeen = Date.now();
  }
}
function sweepStaleVehicles(){
  var now = Date.now();
  vehicles.forEach(function(entry, id){
    if (now - entry.lastSeen > STALE_MS) { map.removeLayer(entry.marker); vehicles.delete(id); }
  });
  vehCountEl.textContent = String(vehicles.size);
}
setInterval(sweepStaleVehicles, 1000);

function applyApproachState(payload){
  var layer = edgeLayers[payload.movement_id];
  if (layer) layer.setStyle({ color: occupancyColor(payload.occupancy), weight: 4, opacity: 0.95 });
}

function connect(){
  setStatus("connecting", "connecting…");
  var ws;
  try { ws = new WebSocket(WS_URL); } catch (e) { setStatus("closed", "no backend running"); return; }
  ws.onopen = function(){ setStatus("open", "connected"); };
  ws.onclose = function(){ setStatus("closed", "disconnected — retrying in 3s"); setTimeout(connect, 3000); };
  ws.onerror = function(){ ws.close(); };
  ws.onmessage = function(evt){
    var envelope;
    try { envelope = JSON.parse(evt.data); } catch (e) { return; }
    evtCount += 1;
    evtCountEl.textContent = String(evtCount);
    appendRow(envelope);
    if (envelope.event_type === "VehiclePositionUpdated") {
      upsertVehicle(envelope.payload);
      vehCountEl.textContent = String(vehicles.size);
    } else if (envelope.event_type === "ApproachState") {
      applyApproachState(envelope.payload);
    }
  };
}
connect();

})();
</script>
</body>
</html>
