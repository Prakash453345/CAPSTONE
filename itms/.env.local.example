# Copy to .env.local (git ignores it) and fill in. scripts/dev.sh loads it.
# Plain KEY=value lines only: no `export`, and comments on their own lines.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
# Gmail: a 16-character app password (myaccount.google.com/apppasswords), no spaces
SMTP_PASSWORD=
SMTP_FROM="TRAFFIX <you@gmail.com>"
# false = really send the email; true = only print the code in the terminal
AUTH_DEV_LOG_CODES=false
