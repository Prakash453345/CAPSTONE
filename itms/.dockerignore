**/.venv
**/__pycache__
**/*.pyc
.env
**/.env
.local
var
data
baselines
bench
cases
notebooks
astra-handoff
web
web-app/dist
web-app/test-results
web-app/playwright-report
scenarios/**/raw_osm.xml
*.docx
*.osm.xml
