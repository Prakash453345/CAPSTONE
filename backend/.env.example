# ITMS settings. Copy to `.env` (same folder) and fill in:
#     cp .env.example .env
# `.env` is git-ignored: it holds passwords. `scripts/dev.sh` (make dev) loads it,
# and the server setup in deploy/ uses the same names (deploy/.env.example).
# Anything already exported in your shell wins over this file.

# ---- Email (forgot-password codes) -------------------------------------------
# Gmail: SMTP_PASSWORD is an "App password" (Google Account > Security >
# 2-Step Verification > App passwords), not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="TRAFFIX <you@example.com>"
SMTP_STARTTLS=true
# true = also print codes in the api-gateway log (local only; with SMTP_HOST
# set the code is emailed either way). Never true on a server.
AUTH_DEV_LOG_CODES=false

# ---- Sign-in ------------------------------------------------------------------
# Signs session cookies. Set it once (openssl rand -hex 32) so a restart does
# not sign everyone out. Blank: dev.sh uses .local/auth_secret.env if present.
AUTH_SECRET=
# false only for plain http://localhost. Behind https (a server, a tunnel): true.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=12
# Commands and the live stream need a signed-in account. false = open (scripts).
API_REQUIRE_SIGN_IN=true

# ---- Databases ----------------------------------------------------------------
DATABASE_URL=postgresql://itms:itms@localhost:5432/itms
REDIS_URL=redis://localhost:6379/0

# ---- Simulation ---------------------------------------------------------------
SIM_MODE=live
SIM_DEMAND=light
SIM_REALTIME_FACTOR=1.0
# Another city: ITMS_SCENARIO=data/scenarios/generated/amaravati_capital (or make dev-amaravati)
# ITMS_SCENARIO=

# ---- Crews --------------------------------------------------------------------
# true: the nearest free crew is assigned a call at once and notified.
# false: the crew is asked first (Accept / Decline on the crew page).
CREW_AUTO_ACCEPT=true
# false: every crew account is on duty (simulation). true: only crews who
# signed in within CREW_DUTY_WINDOW_HOURS.
CREW_REQUIRE_SIGN_IN=false
CREW_DUTY_WINDOW_HOURS=12
CREW_ROSTER_SECONDS=15
