{
  "type": "record",
  "name": "EmergencyCommand",
  "namespace": "itms.contracts",
  "doc": "A follow-up operator action on an existing EmergencyRequest, on `commands.operator`. RECALCULATE re-runs the router (manual reroute); CANCEL abandons the request and restores anything it reserved; ACTIVATE_CORRIDOR asks for a green corridor along the current route (handled from M7). One schema for all of them so the api-service command surface stays small.",
  "fields": [
    { "name": "request_id", "type": "string" },
    { "name": "action", "type": { "type": "enum", "name": "EmergencyCommandAction", "symbols": ["RECALCULATE", "CANCEL", "ACTIVATE_CORRIDOR", "REASSIGN"] } },
    { "name": "reason", "type": "string", "default": "" },
    { "name": "operator", "type": "string", "default": "operator:console" },
    { "name": "unit_id", "type": "string", "default": "", "doc": "Set by api-service to the vehicle of the signed-in crew account that sent this (never trusted from the client); sim-service ignores the command unless the request is that vehicle's. Empty for an operator, who may act on any request." },
    { "name": "requested_at", "type": { "type": "long", "logicalType": "timestamp-millis" } }
  ]
}
